# DO NOT commit a real secrets.toml to GitHub.
# This file is a TEMPLATE only, showing the format app.py expects.
#
# On Streamlit Community Cloud: after deploying, go to
#   your app -> Settings -> Secrets
# and paste the block below with your real Neon connection string,
# then Save (this triggers an automatic redeploy).

[neon]
connection_string = "postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"
